# ====================================================================
# PhotoStyle Docker 部署环境变量模板
#
# 使用方法：
#   1. cp .env.docker.example .env.docker
#   2. 填入真实值
#   3. docker compose up -d --build
#
# 注意：此文件可提交到 git（无敏感信息），.env.docker 不可提交
# ====================================================================

# ---------- 应用 ----------
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=7823
LOG_LEVEL=INFO
SECRET_KEY=改成你的随机字符串

# ---------- 数据库 ----------
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=photo_style

# ---------- Redis ----------
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ---------- 对象存储 ----------
STORAGE_TYPE=minio
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=photo
MINIO_SECURE=false

# ---------- 千问大模型 ----------
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL_IMAGE=qwen-image-3.0-pro
DASHSCOPE_MODEL_VISION=qwen-vl-plus

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://your-server-ip:7821,http://localhost:7821
