# ====================================================================
# PhotoStyle Docker 部署环境变量模板
#
# 使用方法：
#   1. 复制为 .env.docker 并填入真实值
#      cp .env.docker.example .env.docker
#   2. docker compose up -d --build
#
# 注意：.env.docker 被 .gitignore 忽略，不会提交到 git
# ====================================================================

# ---------- 应用配置 ----------
APP_NAME=PhotoStyle
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=7823

# ---------- 数据库配置 ----------
# MySQL 在宿主机上，容器通过 host.docker.internal 访问
DATABASE_URL=mysql+aiomysql://root:password@host.docker.internal:3306/photostyle

# ---------- Redis 配置 ----------
REDIS_URL=redis://:password@host.docker.internal:6379/0

# ---------- 千问大模型配置 ----------
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL_VISION=qwen-vl-plus
DASHSCOPE_MODEL_IMAGE=qwen-image-2.0-pro-2026-06-22
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing

# ---------- 豆包 / DALL-E（未启用） ----------
DOUBAO_ACCESS_KEY=
DOUBAO_SECRET_KEY=
DALLE_API_KEY=
DALLE_BASE_URL=https://api.openai.com/v1

# ---------- 对象存储配置 ----------
STORAGE_TYPE=minio

# MinIO 公网域名
MINIO_ENDPOINT=your-minio-domain
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=ublog
MINIO_SECURE=true
MINIO_PUBLIC_BASE_URL=https://your-minio-domain

# ---------- OSS（未启用） ----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=photostyle
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ---------- JWT 配置 ----------
JWT_SECRET_KEY=change_me_to_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS 配置 ----------
# 填入实际的二级域名（含 https），多个用逗号分隔
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# ---------- 日志配置 ----------
LOG_LEVEL=INFO

# ---------- SMTP 邮件配置（注册验证码） ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=PhotoStyle
SMTP_USE_TLS=true

# ---------- 支付宝当面付（可选） ----------
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
# 生产网关（正式环境改为 https://openapi.alipay.com/gateway.do）
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# ---------- 限流配置 ----------
RATE_LIMIT_FREE_USER_DAILY_LIMIT=10
