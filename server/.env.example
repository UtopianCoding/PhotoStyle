# ====================================================================
# PhotoStyle 后端环境变量配置示例
#
# 使用方法：
#   1. 复制本文件为 .env ： copy .env.example .env
#   2. 将下方占位符替换为真实值
#   3. 生产环境务必通过系统环境变量或密钥管理服务注入敏感信息
# ====================================================================

# ---------- 应用配置 ----------
APP_NAME=PhotoStyle
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=7823

# ---------- 数据库配置 (MySQL) ----------
# 异步驱动使用 aiomysql，连接串格式：
# mysql+aiomysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/photostyle

# ---------- Redis 配置 ----------
# 本地无密码：redis://localhost:6379/0
# 带密码格式：redis://:密码@主机:端口/数据库编号
REDIS_URL=redis://localhost:6379/0

# ---------- 阿里云 DashScope（千问）配置 ----------
# DashScope / 百炼 API Key（支持 sk- 或 sk-ws- 前缀）
DASHSCOPE_API_KEY=your_dashscope_or_bailian_api_key
DASHSCOPE_MODEL_VISION=qwen-vl-plus
# 图像生成模型：wanx-v1 / Qwen-Image-3.0-Pro
DASHSCOPE_MODEL_IMAGE=Qwen-Image-3.0-Pro

# ---------- 火山引擎（豆包）配置 ----------
DOUBAO_ACCESS_KEY=your_doubao_access_key
DOUBAO_SECRET_KEY=your_doubao_secret_key

# ---------- OpenAI（DALL-E）配置 ----------
DALLE_API_KEY=your_openai_api_key
DALLE_BASE_URL=https://api.openai.com/v1
# 图像生成模型名（如 dall-e-3）
DALLE_MODEL_IMAGE=dall-e-3

# ---------- MiniMax 配置 ----------
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# 图像生成模型名
MINIMAX_MODEL_IMAGE=image-01

# ---------- 火山引擎（Seedream 图像生成）配置 ----------
# 在方舟平台获取 API Key：https://console.volcengine.com/ark/region:cn-beijing/apiKey
VOLCENGINE_API_KEY=your_volcengine_api_key
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 图像生成模型名：doubao-seedream-5-0-pro / doubao-seedream-5-0-lite / doubao-seedream-4-5 / doubao-seedream-4-0
VOLCENGINE_MODEL_IMAGE=doubao-seedream-4-0-250828
# 是否在生成图片右下角添加「AI 生成」水印（false = 不加水印，true = 加水印）
VOLCENGINE_WATERMARK=false

# ---------- 模型路由配置 ----------
# 默认图像生成 Provider ID：qianwen / dalle / minimax / doubao / volcengine
MODEL_DEFAULT_PROVIDER=qianwen

# ---------- 对象存储配置 ----------
# 存储类型：minio / oss（选择使用哪种存储方式）
STORAGE_TYPE=minio

# MinIO 配置（STORAGE_TYPE=minio 时使用）
# 端点不含协议，如 abcd.symlzz.cn 或 localhost:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 存储桶名称（如 photo / photostyle）
MINIO_BUCKET=photostyle
# 是否使用 HTTPS（域名部署建议 true，本地 false）
MINIO_SECURE=false
# 对外访问基地址（用于生成公开 URL）
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# 阿里云 OSS 配置（STORAGE_TYPE=oss 时使用）
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=photostyle
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ---------- JWT 配置 ----------
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS 配置 ----------
# 多个来源用英文逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:7821,http://localhost:5173,http://localhost:3000

# ---------- 日志配置 ----------
# 可选值：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ---------- 积分配置 ----------
# 每次转换扣除的积分数
RATE_LIMIT_CREDIT_COST_PER_CONVERT=4
